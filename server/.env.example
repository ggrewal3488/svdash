# Postgres connection for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/master_pms?schema=public"

# The Master app's existing Apps Script /exec URL (master/backend/Code.gs).
# Same URL already hardcoded in UpdateFragment.kt, RemoteConfigManager.kt and
# master/web/app.js — override here only if you deploy a separate instance.
BRIDGE_SHEET_URL="https://script.google.com/macros/s/AKfycbxRb032fWp2LCcF0EDWJ-AcHVvUs_gRBD4obQsV14YE1Cf80DwEoqGpe21Njzku3R6vRQ/exec"

# Shared secret the Apps Script checks on getBookings (DEVICE_KEY in
# master/backend/Code.gs). Booking rows carry guest PII, so unlike getPromos
# the read is authorised.
BRIDGE_DEVICE_KEY="CHANGE-ME-DEVICE-KEY-BEFORE-DEPLOYING"

# The Bookings tab has no property column — this deployment serves one property.
PROPERTY_CODE="SVR-GGN"
PROPERTY_NAME="StayVista Residences Gurgaon"

# Shared secret for this API. Every endpoint except /health and the static
# front-desk page requires it, sent as `x-api-key` or a bearer token. There is
# no default: if this is unset the server refuses all requests rather than
# falling open with guest PII behind it.
MASTER_API_KEY="CHANGE-ME-A-LONG-RANDOM-STRING"

# How often to pull the Bookings tab. 0 disables the scheduler.
SYNC_INTERVAL_MINUTES=15

PORT=8080
