generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Housekeeping's vocabulary: a vacant room is either dirty (just checked out,
// awaiting HK) or ready to sell. HK moves vacant_dirty -> vacant_ready.
enum RoomStatus {
  vacant_ready
  vacant_dirty
  occupied
  maintenance
  out_of_order
}

enum RoomCategory {
  comfort
  executive
  office_suite
}

enum ReservationStatus {
  confirmed
  checked_in
  checked_out
  cancelled
}

enum GuestRole {
  primary
  secondary
}

enum IdType {
  passport
  drivers_license
  national_id
  aadhaar
  other
}

enum CardStatus {
  issued
  active
  expired
  revoked
}

enum UserRole {
  Admin
  User
}

// Front-desk logins for server/public — mirrors master/web's own Users tab
// (master/backend/Code.gs), kept as a separate table here since this API's
// auth is Postgres-backed, not the Sheet's.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(User)
  createdAt    DateTime @default(now())
}

model Property {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique
  rooms        Room[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
}

model Room {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id])
  roomNumber   String
  category     RoomCategory
  status       RoomStatus    @default(vacant_ready)
  reservations Reservation[]
  cards        Card[]

  @@unique([propertyId, roomNumber])
}

model Guest {
  id                String             @id @default(cuid())
  salutation        String?
  firstName         String
  lastName          String
  phone             String?
  email             String?
  idDocuments       IdDocument[]
  reservationGuests ReservationGuest[]
  cards             Card[]
  createdAt         DateTime           @default(now())

  @@index([lastName])
}

// Section 05 of the Master Platform Blueprint addendum.
model IdDocument {
  id             String    @id @default(cuid())
  guestId        String
  guest          Guest     @relation(fields: [guestId], references: [id])
  idType         IdType
  idNumber       String
  issuingCountry String?
  expiry         DateTime?
  scanRef        String?
  createdAt      DateTime  @default(now())

  @@index([idNumber])
}

model Reservation {
  id             String             @id @default(cuid())
  // Foreign key back to the property's existing PMS — Master imports
  // reservations, it does not originate them.
  externalPmsId  String             @unique
  propertyId     String
  property       Property           @relation(fields: [propertyId], references: [id])
  roomId         String?
  room           Room?              @relation(fields: [roomId], references: [id])
  checkin        DateTime
  checkout       DateTime
  status         ReservationStatus  @default(confirmed)
  message        String?
  // How many people the booking is for. The front desk must collect name,
  // phone and an ID proof for each one, so this is the target guest count a
  // reservation is measured against before check-in.
  pax            Int?
  // The BD tab's room category (e.g. "executive", "comfort") — a hint for
  // room assignment, not a link to actual inventory the way roomId is.
  roomType       String?
  sourcePrimary  String?
  sourceSecondary String?
  guests         ReservationGuest[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// Section 05 of the Master Platform Blueprint addendum.
model ReservationGuest {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestId       String
  guest         Guest       @relation(fields: [guestId], references: [id])
  role          GuestRole

  @@unique([reservationId, guestId])
}

model Card {
  id        String     @id @default(cuid())
  guestId   String
  guest     Guest      @relation(fields: [guestId], references: [id])
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id])
  status    CardStatus @default(issued)
  issuedAt  DateTime   @default(now())
  expiresAt DateTime?
}
