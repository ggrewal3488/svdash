<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTicketLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Room 204"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTicketStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_danger"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Open"
            android:textColor="@color/danger"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTicketIssue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AC not cooling"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvTicketMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raised by ggrewal · 2026-08-24"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/ticketActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnTicketInProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent"
            android:text="MARK IN PROGRESS"
            android:textSize="11sp"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnTicketResolve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:text="RESOLVE"
            android:textSize="11sp"
            android:textColor="@color/ok" />
    </LinearLayout>

</LinearLayout>
