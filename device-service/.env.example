# Where bridge32/ is listening (localhost only — it should never be exposed
# off this machine, since it's the process with direct hardware access).
BRIDGE32_URL="http://127.0.0.1:8091"

# Shared secret every route except /health requires, as `x-api-key` or a
# bearer token (see src/auth.ts). There is no default: if this is unset the
# service refuses all requests rather than falling open in front of hardware
# that can write physical key cards. Must match DEVICE_SERVICE_KEY in
# server/.env.
DEVICE_SERVICE_KEY="CHANGE-ME-A-LONG-RANDOM-STRING"

PORT=8092
